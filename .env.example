# ── Base de datos ────────────────────────────────────────────────
POSTGRES_USER=panel
POSTGRES_PASSWORD=            # openssl rand -base64 32
POSTGRES_DB=panel
DB_PORT=5432                  # 5433 si el 5432 del host está ocupado
DATABASE_URL=postgres://panel:PASSWORD@127.0.0.1:5432/panel

# ── App ──────────────────────────────────────────────────────────
DASHBOARD_PASSWORD=           # openssl rand -base64 24 · min 24 caracteres
DASHBOARD_TZ=America/Argentina/Buenos_Aires
NEXT_PUBLIC_SITE_URL=https://panel.hilvanapp.com

# Secreto con el que se FIRMA la cookie de sesión (HMAC). Desde la migración 030
# la cookie lleva el id del usuario y ya no se puede firmar con la clave de cada
# uno.
#
# Default en código: DASHBOARD_PASSWORD (lib/auth.ts). El default es a propósito:
# las dos instancias deployan del mismo origin/main y ninguna declara esta
# variable, así que sin el default el próximo deploy las deja sin poder firmar.
# NO es requerida por el deploy (no está en el REQUIRED de deploy/deploy.sh).
#
# Rotarla invalida las sesiones de TODOS y es la única palanca para echar a
# alguien en el acto (no hay tabla de sesiones ni denylist).
PANEL_SESSION_SECRET=

# Usuario y nombre del admin que siembra `npm run usuarios:seed`. El admin es
# distinto por instancia (hilvanapp → lucho, infinix → Ivan), y una migración no
# lee env vars, así que la identidad va acá.
#
# Default en código: lucho / Lucho (el valor histórico de hilvanapp). NO son
# requeridas por el deploy: sin declararlas, el seed crea 'lucho' como admin. En
# infinix se corre a mano con PANEL_ADMIN_USUARIO=ivan PANEL_ADMIN_NOMBRE=Ivan.
PANEL_ADMIN_USUARIO=lucho
PANEL_ADMIN_NOMBRE=Lucho

# Nombre que el panel muestra en el header y en la pestaña del navegador.
# Default en código: 'Hilvan'. Varias instancias deployan de este mismo repo, así
# que cada una tiene que declarar el suyo o va a mostrar el del otro proyecto.
PANEL_BRAND=Hilvan

# Moneda en la que el panel CONSOLIDA todo: la unidad de las columnas *_eur, del
# par que busca el fetcher de cotizaciones y de los importes de la UI. Soporta
# EUR y USD (son las dos que tienen fetcher implementado en lib/fx-fetch.ts).
#
# Default 'EUR'. NO la cambies en una instancia que ya tiene ventas cargadas sin
# leer antes lib/moneda-reporte.ts: los montos convertidos se congelan en el
# momento de la ingesta y no se recalculan al leer, así que cambiarla mezcla dos
# monedas en la misma columna sin que nada falle. En una base nueva es gratis.
#
# Un valor no soportado hace fallar el arranque a propósito: sin fetcher para ese
# par, fx_rates quedaría vacía y todas las ventas entrarían sin monto convertido.
NEXT_PUBLIC_REPORT_CURRENCY=EUR

# ── Webhooks ─────────────────────────────────────────────────────
# Los MISMOS secrets que ya están en el env de cada funnel: las suscripciones
# creadas desde el admin de la tienda firman con el secret de la tienda.
SHOPIFY_WEBHOOK_SECRETS=

# ── Leads (solo lectura, por funnel) ─────────────────────────────
SUPABASE_URL_CHAUHINCHAZON=
SUPABASE_SERVICE_KEY_CHAUHINCHAZON=
SUPABASE_URL_RESET=
SUPABASE_SERVICE_KEY_RESET=

# ── Publicidad (Meta Marketing API) ───────────────────────────────
# Usuario del sistema con ads_read Y ads_management, y la cuenta asignada con
# rol de administrador. NO es el token de CAPI de los funnels: ese solo tiene
# read_ads_dataset_quality y /me/adaccounts le devuelve "(#200) Missing
# Permissions". Verificar con: npm run ads:token
#
# OJO: hoy esta variable NO está en el .env local, solo en el .env.production de
# la VPS, y nunca se documentó. Sin ella, las verificaciones de este módulo
# salen con access_token vacío y Meta contesta algo sobre credenciales que
# manda a buscar un problema de permisos que no existe.
META_ADS_TOKEN=
# Versión de la Graph API. Configurable a propósito: el sunset de v21 cae
# alrededor de principios de 2027 y subir de versión no puede requerir un
# deploy de código. Formato vXX.Y, validado al arrancar.
META_API_VERSION=v21.0
# ALLOWLIST del objeto sobre el que `npm run ads:token` puede escribir su no-op.
# Una campaña o conjunto PAUSADO y descartable, elegido a mano. Sin esto, el
# script reporta que la escritura no quedó verificada y NO elige uno solo.
ADS_TEST_OBJECT_ID=
# Refresco del gasto en el render, cuando el rango incluye hoy.
#
# TTL: cuántos segundos se considera fresco el último sync. Es el ÚNICO freno
# real contra los rate limits de Meta, porque se compara contra
# ad_accounts.last_sync_at, que es uno para todas las pestañas y todos los
# pedidos: con esto en 60, mil requests por minuto siguen siendo una llamada a
# Meta. Se lee en caliente, así que se puede subir con un restart si Meta aprieta
# (códigos 17 / 613, ver docs/runbook-anuncios.md).
ADS_LIVE_TTL_SECONDS=60
ADS_LIVE_TIMEOUT_MS=8000

# Cada cuántos segundos el panel repite el pedido para traer el gasto, con la
# pestaña a la vista. 0 lo apaga; el mínimo efectivo es 15.
#
# OJO: es NEXT_PUBLIC_, o sea que se hornea en el bundle EN EL BUILD. Cambiarla
# necesita un deploy, a diferencia del TTL de arriba. Bajarla NO sube las
# llamadas a Meta (las frena el TTL), sube los requests al panel y las consultas
# a la base.
#
# 60 y no 30 porque del otro lado no hay nada más rápido: los números de Meta se
# recalculan cada varios minutos, así que pedirlos cada 30 segundos devuelve dos
# veces el mismo valor. Si el gasto se ve atrasado y esta variable está en 60, el
# atraso es de Meta y no del panel: mirá la Marca_Frescura, que dice cuándo fue el
# último sync que SÍ trajo datos.
NEXT_PUBLIC_ADS_POLL_SECONDS=60

# ── Análisis con IA (OpenAI) ──────────────────────────────────────────────
# LA FEATURE SE PRENDE POR LA PRESENCIA DE ESTA VARIABLE. No hay un
# IA_HABILITADA aparte: sin key, el widget del Resumen no se ofrece, la tarjeta
# de Finanzas no se dibuja y el cron sale con 0. Eso deja BYTE-IDENTICA a la
# instancia que no la declare, que es lo que pide la regla de instancias (el
# default siempre es el comportamiento que ya había, y hasta ahora ninguno de los
# dos paneles tenía IA).
#
# NO es NEXT_PUBLIC_ y no puede serlo: es un secreto y una NEXT_PUBLIC_ se hornea
# en el bundle del browser, o sea que cualquiera con el inspector se la lleva y
# te gasta el crédito. El análisis se genera SIEMPRE en el server.
#
# Se saca de https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Qué modelo usa. Configurable porque el catálogo de OpenAI se mueve más rápido
# que los deploys de este panel.
#
# Default en código: gpt-4o-mini. Es el ID que con más seguridad existe en
# cualquier cuenta y soporta json_schema con strict:true, que es lo que el módulo
# necesita. Si hay uno más nuevo o más barato en tu cuenta, ponelo acá; verificá
# el ID exacto con:
#   curl -s https://api.openai.com/v1/models \
#     -H "Authorization: Bearer $OPENAI_API_KEY" | grep -o '"id": "[^"]*"'
#
# Un ID inexistente falla con un 404 claro de la API. No hay lista blanca en
# código a propósito: quedaría vieja y rechazaría el modelo bueno.
OPENAI_MODEL=gpt-4o-mini

# Techo DURO de análisis generados por día, contado sobre ai_insights en la TZ del
# dashboard. Es el freno que no depende de que el código esté bien.
#
# El uso normal son 2 por día (el cron genera Resumen y Finanzas). El resto del
# margen es para el botón "Analizar". Los aciertos de caché NO cuentan: si los
# números no cambiaron no se llama a OpenAI, así que apretar el botón diez veces
# sobre los mismos datos consume 1.
OPENAI_INSIGHTS_MAX_DIA=20

# Cuánto se espera a que el modelo conteste. 60 s porque un modelo razonando sobre
# 100 números tarda bastante más que un endpoint de cotizaciones.
OPENAI_TIMEOUT_MS=60000
